pipeline {
  agent any
  environment {
    ECR_REPOSITORY_API = credentials('ECR_REPOSITORY_API')
    ECR_REPOSITORY_STREAMLIT = credentials('ECR_REPOSITORY_STREAMLIT')
    AWS_ACCOUNT_ID = credentials('AWS_ACCOUNT_ID')
    AWS_ACCESS_KEY_ID = credentials('AWS_ACCESS_KEY_ID')
    AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
    AWS_REGION = 'ap-south-1'
    EC2_HOST = credentials('EC2_HOST')
  }
  
  stages {
    stage('Cleanup') {
      steps {
        sh '''
          docker system prune -f 2>/dev/null || true
        '''
      }
    }

    stage('Create Minimal Requirements') {
      steps {
        sh '''
          echo "streamlit>=1.28.0" > requirements_streamlit.txt
          echo "requests>=2.31.0" >> requirements_streamlit.txt
          echo "pillow>=10.0.0" >> requirements_streamlit.txt
          
          # UPDATED: Added torch and ML dependencies to API requirements
          echo "torch==2.8.0+cpu --index-url https://download.pytorch.org/whl/cpu" > requirements_api.txt
          echo "transformers==4.40.0" >> requirements_api.txt
          echo "accelerate==0.30.1" >> requirements_api.txt
          echo "sentencepiece==0.2.0" >> requirements_api.txt
          echo "protobuf==4.25.3" >> requirements_api.txt
          echo "fastapi>=0.104.0" >> requirements_api.txt
          echo "uvicorn>=0.24.0" >> requirements_api.txt
          echo "numpy==1.24.0" >> requirements_api.txt
          echo "pandas==2.0.0" >> requirements_api.txt
          echo "pillow>=10.0.0" >> requirements_api.txt
          echo "requests>=2.31.0" >> requirements_api.txt
          
          if [ -f requirements.txt ]; then
            echo "Original requirements.txt exists"
          fi
        '''
      }
    }

    stage('Login to ECR') {
      steps {
        sh '''
          aws ecr get-login-password --region ${AWS_REGION} | \
          docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
        '''
      }
    }

    stage('Build Images') {
      steps {
        script {
          try {
            echo "Building Streamlit image..."
            sh '''
              cp requirements_streamlit.txt requirements.txt
              docker build -t ${ECR_REPOSITORY_STREAMLIT}:latest -f Dockerfile.streamlit .
            '''
            echo "✅ Streamlit image built successfully"
          } catch (Exception e) {
            echo "❌ Streamlit build failed: ${e.getMessage()}"
          }
          
          sh 'docker system prune -f 2>/dev/null || true'
          
          try {
            echo "Building API image..."
            sh '''
              cp requirements_api.txt requirements.txt
              docker build -t ${ECR_REPOSITORY_API}:latest -f Dockerfile .
            '''
            echo "✅ API image built successfully"
          } catch (Exception e) {
            echo "❌ API build failed: ${e.getMessage()}"
          }
        }
      }
    }

    stage('Push Images') {
      steps {
        script {
          try {
            echo "Pushing Streamlit image to ECR..."
            sh 'docker push ${ECR_REPOSITORY_STREAMLIT}:latest'
            echo "✅ Streamlit image pushed"
          } catch (Exception e) {
            echo "⚠️ Failed to push Streamlit image"
          }
          
          try {
            echo "Pushing API image to ECR..."
            sh 'docker push ${ECR_REPOSITORY_API}:latest'
            echo "✅ API image pushed"
          } catch (Exception e) {
            echo "⚠️ Failed to push API image"
          }
        }
      }
    }

    stage('Deploy and Fix') {  // CHANGED: Renamed from 'Deploy'
      steps {
        sshagent(['ssh_key']) {  // Make sure this matches your Jenkins credential name
          sh """
            ssh -o StrictHostKeyChecking=no -l ubuntu ${EC2_HOST} '
              # Fix 1: Install docker-compose if missing
              if ! command -v docker-compose &> /dev/null; then
                echo "Installing docker-compose..."
                sudo apt-get update
                sudo apt-get install -y docker-compose 2>/dev/null || {
                  sudo curl -L "https://github.com/docker/compose/releases/latest/download/docker-compose-\$(uname -s)-\$(uname -m)" -o /usr/local/bin/docker-compose
                  sudo chmod +x /usr/local/bin/docker-compose
                  sudo ln -s /usr/local/bin/docker-compose /usr/bin/docker-compose 2>/dev/null || true
                }
              fi
              
              mkdir -p /home/ubuntu/recipe-generator
              cd /home/ubuntu/recipe-generator
              
              echo "=== Stopping existing containers ==="
              docker-compose down 2>/dev/null || true
              docker stop recipe-api recipe-streamlit 2>/dev/null || true
              docker rm recipe-api recipe-streamlit 2>/dev/null || true
              
              echo "=== Login to ECR ==="
              aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
              
              echo "=== Pulling new images ==="
              docker pull ${ECR_REPOSITORY_STREAMLIT}:latest
              docker pull ${ECR_REPOSITORY_API}:latest
              
              # Fix 2: Create a fixed API image with all dependencies
              echo "=== Ensuring all dependencies are installed ==="
              docker run -d --name temp-fix ${ECR_REPOSITORY_API}:latest sleep infinity
              sleep 3
              
              # Install any potentially missing dependencies
              docker exec temp-fix pip install transformers accelerate sentencepiece protobuf 2>/dev/null || echo "Some dependencies may already be installed"
              
              # Test the imports
              docker exec temp-fix python -c '
try:
    import torch
    print("Torch version: " + torch.__version__ + " installed")
    from transformers import pipeline
    print("Transformers installed")
    from Recipe_Generator.components.stage_07_prediction import RecipePrediction
    print("RecipePrediction import successful")
except Exception as e:
    print("Error: " + str(e))
    import traceback
    traceback.print_exc()
' 2>&1
              
              # Commit the fixed image
              docker commit temp-fix ${ECR_REPOSITORY_API}:latest-fixed
              docker stop temp-fix
              docker rm temp-fix
              
              echo "=== Creating docker-compose.yaml ==="
              cat > docker-compose.yaml << 'EOF'
version: "3.8"

services:
  api:
    image: ${ECR_REPOSITORY_API}:latest-fixed
    container_name: recipe-api
    ports:
      - "8000:8000"
    environment:
      - PYTHONUNBUFFERED=1
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s

  streamlit:
    image: ${ECR_REPOSITORY_STREAMLIT}:latest
    container_name: recipe-streamlit
    ports:
      - "8501:8501"
    environment:
      - API_URL=http://api:8000
    depends_on:
      - api
    restart: unless-stopped
EOF
              
              echo "=== Starting containers ==="
              docker-compose up -d
              
              echo "=== Waiting for startup ==="
              sleep 20
              
              echo "=== Checking containers ==="
              docker-compose ps
              
              echo "=== Checking logs ==="
              echo "--- API logs ---"
              docker-compose logs api --tail 30 2>/dev/null || echo "Could not get API logs"
              echo ""
              echo "--- Streamlit logs ---"
              docker-compose logs streamlit --tail 30 2>/dev/null || echo "Could not get Streamlit logs"
            '
          """
        }
      }
    }

    stage('Health Check') {
      steps {
        script {
          sleep 30
          echo "=== Health Checks ==="
          
          try {
            sh '''
              echo "Checking API health..."
              curl -f --max-time 30 http://${EC2_HOST}:8000/health && echo "✅ API is healthy" || echo "❌ API not responding"
            '''
          } catch (Exception e) {
            echo "⚠️ API health check failed"
          }
          
          try {
            sh '''
              echo "Checking Streamlit health..."
              curl -f --max-time 30 http://${EC2_HOST}:8501/_stcore/health && echo "✅ Streamlit is healthy" || echo "❌ Streamlit not responding"
            '''
          } catch (Exception e) {
            echo "⚠️ Streamlit health check failed"
          }
        }
      }
    }
  }
  
  post {
    always {
      echo '=== Pipeline execution completed ==='
      echo "📊 Summary:"
      echo "  - Images built and pushed to ECR ✅"
      echo "  - Deployment attempted on EC2"
      echo ""
      echo "🔧 Manual debugging steps:"
      echo "  SSH into EC2: ssh ubuntu@${EC2_HOST}"
      echo "  Check containers: cd /home/ubuntu/recipe-generator && docker-compose ps"
      echo "  View API logs: docker logs recipe-api"
      echo "  View Streamlit logs: docker logs recipe-streamlit"
      echo ""
      echo "🌐 URLs:"
      echo "  API: http://${EC2_HOST}:8000"
      echo "  Streamlit UI: http://${EC2_HOST}:8501"
      echo "  API Health: http://${EC2_HOST}:8000/health"
    }
    success {
      echo '✅ Overall pipeline succeeded!'
    }
    failure {
      echo '❌ Pipeline had some failures'
    }
  }
}