pipeline {
  agent any
  environment {
    ECR_REPOSITORY_API = credentials('ECR_REPOSITORY_API')
    ECR_REPOSITORY_STREAMLIT = credentials('ECR_REPOSITORY_STREAMLIT')
    AWS_ACCOUNT_ID = credentials('AWS_ACCOUNT_ID')
    AWS_ACCESS_KEY_ID = credentials('AWS_ACCESS_KEY_ID')
    AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
    AWS_REGION = 'ap-south-1'
    EC2_HOST = credentials('EC2_HOST')
  }
  
  stages {
    stage('Clean Disk Space') {
      steps {
        script {
          echo "Cleaning up disk space before build"
          sh '''
            # Clean Docker cache and unused containers/images
            docker system prune -a -f --volumes || true
            # Clean Jenkins workspace
            rm -rf ${WORKSPACE}/.cache ${WORKSPACE}/.npm ${WORKSPACE}/.m2 || true
            # Check disk space
            df -h
            # Check Docker disk usage
            docker system df
          '''
        }
      }
    }

    stage('Setup Environment') {
      steps {
        script {
          // Install required Python tools
          sh '''
            pip install flake8 pytest || true
          '''
        }
      }
    }

    stage('Optimize Requirements') {
      steps {
        script {
          // Create a minimal requirements.txt for Streamlit to reduce space
          sh '''
            if [ -f requirements.txt ]; then
              # Create a minimal version for Streamlit (remove heavy ML packages)
              grep -v "torch\\|torchvision\\|transformers\\|faiss\\|onnxruntime\\|opencv-python\\|chromadb" requirements.txt > requirements_streamlit.txt || cat requirements.txt > requirements_streamlit.txt
            else
              # Create minimal requirements
              echo "streamlit>=1.28.0" > requirements_streamlit.txt
              echo "requests>=2.31.0" >> requirements_streamlit.txt
              echo "pillow>=10.0.0" >> requirements_streamlit.txt
              echo "numpy>=1.24.0" >> requirements_streamlit.txt
              echo "pandas>=2.0.0" >> requirements_streamlit.txt
            fi
            
            # Also create minimal for API if needed
            if [ -f requirements.txt ]; then
              cp requirements.txt requirements_api.txt
            fi
          '''
        }
      }
    }

    stage('Continuous Integration') {
      steps {
        script {
          echo "Linting repository"
          sh 'python -m flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics || true'
          echo "Running unit tests"
          sh 'python -m pytest tests/ -v --tb=short || true'
        }
      }
    }

    stage('Create Artifacts Directory') {
      steps {
        script {
          sh '''
            mkdir -p artifacts/images || true
            # Create minimal artifacts structure
            touch artifacts/.gitkeep || true
          '''
        }
      }
    }

    stage('Login to ECR') {
      steps {
        script {
          sh '''
            aws ecr get-login-password --region ${AWS_REGION} | \
            docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
          '''
        }
      }
    }

    stage('Build Images') {
      steps {
        script {
          echo "Building API image with optimized requirements"
          sh '''
            # Clean Docker cache before each build
            docker builder prune -f
            
            # Build API with specific requirements
            if [ -f requirements_api.txt ]; then
              docker build --no-cache \
                --build-arg REQUIREMENTS_FILE=requirements_api.txt \
                -t ${ECR_REPOSITORY_API}:latest \
                -f Dockerfile .
            else
              docker build --no-cache \
                -t ${ECR_REPOSITORY_API}:latest \
                -f Dockerfile .
            fi
            
            # Clean cache after API build
            docker builder prune -f
          '''
          
          echo "Building Streamlit image with minimal dependencies"
          sh '''
            # Clean cache before Streamlit build
            docker builder prune -f
            
            # Build Streamlit with minimal requirements
            cp requirements_streamlit.txt requirements.txt || true
            docker build --no-cache \
              -t ${ECR_REPOSITORY_STREAMLIT}:latest \
              -f Dockerfile.streamlit .
            
            # Restore original requirements.txt if it existed
            if [ -f requirements_api.txt ]; then
              cp requirements_api.txt requirements.txt || true
            fi
            
            # Clean cache after build
            docker builder prune -f
          '''
        }
      }
    }

    stage('Push Images') {
      steps {
        script {
          echo "Pushing API image to ECR"
          sh 'docker push ${ECR_REPOSITORY_API}:latest'
          
          echo "Pushing Streamlit image to ECR"
          sh 'docker push ${ECR_REPOSITORY_STREAMLIT}:latest'
        }
      }
    }

    stage('Continuous Deployment') {
      steps {
        sshagent(['ssh_key']) {
          sh """
            ssh -o StrictHostKeyChecking=no -l ubuntu ${EC2_HOST} '
              cd /home/ubuntu/recipe-generator && 
              wget -O docker-compose.yaml https://raw.githubusercontent.com/rahul22106/Image_to_Food_Recipe_Generator/refs/heads/main/docker-compose.yaml && 
              export IMAGE_API=${ECR_REPOSITORY_API}:latest && 
              export IMAGE_STREAMLIT=${ECR_REPOSITORY_STREAMLIT}:latest && 
              aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com && 
              docker-compose down &&
              docker-compose pull &&
              docker-compose up -d &&
              docker system prune -f
            '
          """
        }
      }
    }

    stage('Health Check') {
      steps {
        script {
          sleep 30
          sh 'curl -f http://${EC2_HOST}:8000/health || exit 1'
          echo "✅ Deployment successful and API is healthy!"
        }
      }
    }
  }

  post {
    always {
      sh '''
        # Aggressive cleanup
        docker system prune -a -f --volumes || true
        docker builder prune -a -f || true
        # Clean workspace
        rm -rf ${WORKSPACE}/.cache ${WORKSPACE}/.docker ${WORKSPACE}/__pycache__ || true
      '''
    }
    success {
      echo '✅ Pipeline completed successfully!'
    }
    failure {
      echo '❌ Pipeline failed!'
    }
  }
}