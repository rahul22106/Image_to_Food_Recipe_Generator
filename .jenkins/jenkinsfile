pipeline {
  agent any
  environment {
    ECR_REPOSITORY_API = credentials('ECR_REPOSITORY_API')
    ECR_REPOSITORY_STREAMLIT = credentials('ECR_REPOSITORY_STREAMLIT')
    AWS_ACCOUNT_ID = credentials('AWS_ACCOUNT_ID')
    AWS_ACCESS_KEY_ID = credentials('AWS_ACCESS_KEY_ID')
    AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
    AWS_REGION = 'ap-south-1'
    EC2_HOST = credentials('EC2_HOST')
  }
  
  stages {
    stage('Check Disk Space') {
      steps {
        script {
          sh '''
            echo "=== Disk Space Before Build ==="
            df -h
            echo "=== Docker Disk Usage ==="
            docker system df
            echo "=== Cleaning up ==="
            docker system prune -a -f --volumes
            docker builder prune -a -f
            rm -rf /tmp/* /var/tmp/*
          '''
        }
      }
    }

    stage('Create Ultra Minimal Requirements') {
      steps {
        script {
          sh '''
            # Create absolute minimal requirements for Streamlit
            echo "streamlit==1.28.0" > requirements_minimal.txt
            echo "requests==2.31.0" >> requirements_minimal.txt
            echo "pillow==10.0.0" >> requirements_minimal.txt
            
            # Create lightweight requirements for API if needed
            if [ -f requirements.txt ]; then
              # Try to keep only essential packages
              grep -E "^(fastapi|uvicorn|pydantic|numpy|pandas|pillow|requests)=" requirements.txt > requirements_light.txt 2>/dev/null || echo "" > requirements_light.txt
              # Add minimal versions if file is empty
              if [ ! -s requirements_light.txt ]; then
                echo "fastapi==0.104.0" > requirements_light.txt
                echo "uvicorn==0.24.0" >> requirements_light.txt
                echo "pydantic==2.4.0" >> requirements_light.txt
                echo "numpy==1.24.0" >> requirements_light.txt
              fi
            fi
          '''
        }
      }
    }

    stage('Continuous Integration') {
      steps {
        script {
          echo "Linting repository"
          sh 'python -m flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics || true'
          echo "Running unit tests"
          sh 'python -m pytest tests/ -v --tb=short --cov=. --cov-report=term-missing || true'
        }
      }
    }

    stage('Login to ECR') {
      steps {
        script {
          sh '''
            aws ecr get-login-password --region ${AWS_REGION} | \
            docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
          '''
        }
      }
    }

    stage('Build Images with Staged Approach') {
      steps {
        script {
          // Build API image first (likely larger)
          echo "Building API image"
          sh '''
            docker build \
              --no-cache \
              --progress=plain \
              -t ${ECR_REPOSITORY_API}:latest \
              -f Dockerfile.api . 2>&1 | tail -100
          '''
          
          // Clean immediately after API build
          sh '''
            docker system prune -f
            docker builder prune -f
          '''
          
          // Build Streamlit image with minimal requirements
          echo "Building Streamlit image"
          sh '''
            # Copy minimal requirements
            cp requirements_minimal.txt requirements.txt
            docker build \
              --no-cache \
              --progress=plain \
              -t ${ECR_REPOSITORY_STREAMLIT}:latest \
              -f Dockerfile.streamlit.minimal . 2>&1 | tail -100
          '''
        }
      }
    }

    stage('Push Images') {
      steps {
        script {
          echo "Pushing API image to ECR"
          sh 'docker push ${ECR_REPOSITORY_API}:latest'
          
          echo "Pushing Streamlit image to ECR"
          sh 'docker push ${ECR_REPOSITORY_STREAMLIT}:latest'
        }
      }
    }

    stage('Continuous Deployment') {
      steps {
        sshagent(['ssh_key']) {
          sh """
            ssh -o StrictHostKeyChecking=no -l ubuntu ${EC2_HOST} '
              cd /home/ubuntu/recipe-generator && 
              wget -O docker-compose.yaml https://raw.githubusercontent.com/rahul22106/Image_to_Food_Recipe_Generator/refs/heads/main/docker-compose.yaml && 
              export IMAGE_API=${ECR_REPOSITORY_API}:latest && 
              export IMAGE_STREAMLIT=${ECR_REPOSITORY_STREAMLIT}:latest && 
              aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com && 
              docker-compose down &&
              docker-compose pull &&
              docker-compose up -d &&
              docker system prune -f
            '
          """
        }
      }
    }

    stage('Health Check') {
      steps {
        script {
          sleep 30
          sh 'curl -f http://${EC2_HOST}:8000/health || curl -f http://${EC2_HOST}:8501/_stcore/health || exit 1'
          echo "✅ Deployment successful!"
        }
      }
    }
  }

  post {
    always {
      sh '''
        echo "=== Disk Space After Build ==="
        df -h
        echo "=== Final Cleanup ==="
        docker system prune -a -f --volumes
        docker builder prune -a -f
      '''
    }
    success {
      echo '✅ Pipeline completed successfully!'
    }
    failure {
      echo '❌ Pipeline failed!'
    }
  }
}