pipeline {
  agent any
  environment {
    ECR_REPOSITORY_API = credentials('ECR_REPOSITORY_API')
    ECR_REPOSITORY_STREAMLIT = credentials('ECR_REPOSITORY_STREAMLIT')
    AWS_ACCOUNT_ID = credentials('AWS_ACCOUNT_ID')
    AWS_ACCESS_KEY_ID = credentials('AWS_ACCESS_KEY_ID')
    AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
    AWS_REGION = 'ap-south-1'
    EC2_HOST = credentials('EC2_HOST')
  }
  
  stages {
    stage('Cleanup') {
      steps {
        sh '''
          docker system prune -f 2>/dev/null || true
        '''
      }
    }

    stage('Create Minimal Requirements') {
      steps {
        sh '''
          echo "streamlit>=1.28.0" > requirements_streamlit.txt
          echo "requests>=2.31.0" >> requirements_streamlit.txt
          echo "pillow>=10.0.0" >> requirements_streamlit.txt
          
          echo "fastapi>=0.104.0" > requirements_api.txt
          echo "uvicorn>=0.24.0" >> requirements_api.txt
          echo "numpy==1.24.0" >> requirements_api.txt
          echo "pandas==2.0.0" >> requirements_api.txt
          echo "pillow>=10.0.0" >> requirements_api.txt
          echo "requests>=2.31.0" >> requirements_api.txt
          
          if [ -f requirements.txt ]; then
            echo "Original requirements.txt exists"
          fi
        '''
      }
    }

    stage('Login to ECR') {
      steps {
        sh '''
          aws ecr get-login-password --region ${AWS_REGION} | \
          docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
        '''
      }
    }

    stage('Build Images') {
      steps {
        script {
          try {
            echo "Building Streamlit image..."
            sh '''
              cp requirements_streamlit.txt requirements.txt
              docker build -t ${ECR_REPOSITORY_STREAMLIT}:latest -f Dockerfile.streamlit .
            '''
            echo "✅ Streamlit image built successfully"
          } catch (Exception e) {
            echo "❌ Streamlit build failed: ${e.getMessage()}"
          }
          
          sh 'docker system prune -f 2>/dev/null || true'
          
          try {
            echo "Building API image..."
            sh '''
              cp requirements_api.txt requirements.txt
              docker build -t ${ECR_REPOSITORY_API}:latest -f Dockerfile .
            '''
            echo "✅ API image built successfully"
          } catch (Exception e) {
            echo "❌ API build failed: ${e.getMessage()}"
          }
        }
      }
    }

    stage('Push Images') {
      steps {
        script {
          try {
            echo "Pushing Streamlit image to ECR..."
            sh 'docker push ${ECR_REPOSITORY_STREAMLIT}:latest'
            echo "✅ Streamlit image pushed"
          } catch (Exception e) {
            echo "⚠️ Failed to push Streamlit image"
          }
          
          try {
            echo "Pushing API image to ECR..."
            sh 'docker push ${ECR_REPOSITORY_API}:latest'
            echo "✅ API image pushed"
          } catch (Exception e) {
            echo "⚠️ Failed to push API image"
          }
        }
      }
    }

    stage('Deploy') {
      steps {
        sshagent(['ssh_key']) {
          sh """
            ssh -o StrictHostKeyChecking=no -l ubuntu ${EC2_HOST} '
              mkdir -p /home/ubuntu/recipe-generator
              cd /home/ubuntu/recipe-generator
              
              echo "=== Downloading docker-compose.yaml ==="
              wget -q -O docker-compose.yaml https://raw.githubusercontent.com/rahul22106/Image_to_Food_Recipe_Generator/refs/heads/main/docker-compose.yaml || echo "Failed to download docker-compose"
              
              if [ ! -f docker-compose.yaml ]; then
                echo "Creating default docker-compose.yaml..."
                cat > docker-compose.yaml << 'EOF'
version: '3.8'

services:
  api:
    image: \\\${IMAGE_API}
    container_name: recipe-api
    ports:
      - "8000:8000"
    environment:
      - ENVIRONMENT=production
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  streamlit:
    image: \\\${IMAGE_STREAMLIT}
    container_name: recipe-streamlit
    ports:
      - "8501:8501"
    depends_on:
      - api
    environment:
      - API_URL=http://api:8000
    restart: unless-stopped
EOF
              fi
              
              echo "=== Login to ECR ==="
              aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com || echo "ECR login failed"
              
              echo "=== Stopping existing containers ==="
              docker-compose down 2>/dev/null || true
              docker stop recipe-api recipe-streamlit 2>/dev/null || true
              docker rm recipe-api recipe-streamlit 2>/dev/null || true
              docker system prune -f 2>/dev/null || true
              
              echo "=== Pulling new images ==="
              docker pull ${ECR_REPOSITORY_STREAMLIT}:latest 2>/dev/null || echo "Failed to pull Streamlit image"
              docker pull ${ECR_REPOSITORY_API}:latest 2>/dev/null || echo "Failed to pull API image"
              
              echo "=== Starting containers ==="
              export IMAGE_API=${ECR_REPOSITORY_API}:latest
              export IMAGE_STREAMLIT=${ECR_REPOSITORY_STREAMLIT}:latest
              
              echo "API Image: \$IMAGE_API"
              echo "Streamlit Image: \$IMAGE_STREAMLIT"
              
              docker-compose up -d 2>&1 || {
                echo "docker-compose failed, trying manual startup..."
                
                docker run -d \
                  --name recipe-api \
                  -p 8000:8000 \
                  -e ENVIRONMENT=production \
                  --restart unless-stopped \
                  ${ECR_REPOSITORY_API}:latest || echo "Failed to start API container"
                
                sleep 5
                
                docker run -d \
                  --name recipe-streamlit \
                  -p 8501:8501 \
                  -e API_URL=http://${EC2_HOST}:8000 \
                  --restart unless-stopped \
                  ${ECR_REPOSITORY_STREAMLIT}:latest || echo "Failed to start Streamlit container"
              }
              
              echo "=== Deployment completed ==="
              sleep 10
              
              echo "=== Running containers ==="
              docker ps --format "table {{.Names}}\\t{{.Status}}\\t{{.Ports}}" || true
              
              echo "=== Container logs ==="
              docker logs recipe-api --tail 20 2>/dev/null || echo "Could not get API logs"
              docker logs recipe-streamlit --tail 20 2>/dev/null || echo "Could not get Streamlit logs"
            '
          """
        }
      }
    }

    stage('Health Check') {
      steps {
        script {
          sleep 30
          echo "=== Health Checks ==="
          
          try {
            sh '''
              echo "Checking API health..."
              curl -f --max-time 30 http://${EC2_HOST}:8000/health && echo "✅ API is healthy" || echo "❌ API not responding"
            '''
          } catch (Exception e) {
            echo "⚠️ API health check failed"
          }
          
          try {
            sh '''
              echo "Checking Streamlit health..."
              curl -f --max-time 30 http://${EC2_HOST}:8501/_stcore/health && echo "✅ Streamlit is healthy" || echo "❌ Streamlit not responding"
            '''
          } catch (Exception e) {
            echo "⚠️ Streamlit health check failed"
          }
        }
      }
    }
  }
  
  post {
    always {
      echo '=== Pipeline execution completed ==='
      echo "📊 Summary:"
      echo "  - Images built and pushed to ECR ✅"
      echo "  - Deployment attempted on EC2"
      echo ""
      echo "🔧 Manual debugging steps:"
      echo "  SSH into EC2: ssh ubuntu@${EC2_HOST}"
      echo "  Check containers: cd /home/ubuntu/recipe-generator && docker-compose ps"
      echo "  View API logs: docker logs recipe-api"
      echo "  View Streamlit logs: docker logs recipe-streamlit"
      echo ""
      echo "🌐 URLs:"
      echo "  API: http://${EC2_HOST}:8000"
      echo "  Streamlit UI: http://${EC2_HOST}:8501"
      echo "  API Health: http://${EC2_HOST}:8000/health"
    }
    success {
      echo '✅ Overall pipeline succeeded!'
    }
    failure {
      echo '❌ Pipeline had some failures'
    }
  }
}