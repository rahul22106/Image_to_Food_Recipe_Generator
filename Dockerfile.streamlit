FROM python:3.9-alpine

WORKDIR /app

# Install minimal dependencies
RUN apk add --no-cache curl

# Copy requirements
COPY requirements.txt .

# Install Streamlit and essentials only
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    streamlit==1.28.0 \
    requests==2.31.0 \
    pillow==10.0.0

# Install additional from requirements if very small
RUN if [ -f requirements.txt ] && [ $(wc -l < requirements.txt) -lt 5 ]; then \
    pip install --no-cache-dir -r requirements.txt; \
    fi

# Copy only Streamlit app
COPY streamlit_app.py .

EXPOSE 8501

CMD ["streamlit", "run", "streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.maxUploadSize=10"]